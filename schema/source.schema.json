{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Source",
  "description": "External data worth building on: a dataset to backtest against, or a feed to price against.",
  "type": "object",
  "required": ["slug", "name", "url", "kind", "access"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://" },
    "platforms": {
      "description": "Slugs from data/platforms/ this source covers.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "kind": { "enum": ["dataset", "odds-feed"] },
    "prices": {
      "description": "For feeds: which market categories this helps you price.",
      "type": ["string", "null"],
      "maxLength": 80
    },
    "format": { "type": ["string", "null"], "maxLength": 100 },
    "granularity": { "type": ["string", "null"], "maxLength": 100 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "range": { "type": ["string", "null"], "maxLength": 60 },
        "completeness": { "enum": ["full", "partial", "unknown", null] },
        "known_gaps": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "access": { "enum": ["free", "paid", "gated"] },
    "description": { "type": ["string", "null"], "minLength": 10, "maxLength": 200 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true
    }
  }
}
