{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform.schema.json",
  "title": "Platform",
  "description": "A place where people trade or forecast: exchange, protocol, or forecasting site.",
  "type": "object",
  "required": ["slug", "name", "url", "mechanism", "status", "description"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://" },
    "mechanism": {
      "enum": ["onchain-clob", "onchain-amm", "regulated-exchange", "play-money", "forecasting"]
    },
    "chain": { "type": ["string", "null"] },
    "defillama": {
      "description": "DefiLlama protocol slug, if it tracks this venue's volume; used by refresh.py.",
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "aliases": {
      "description": "Other domains this venue operates under; used for dedupe and to accept a third party listing it under a different host.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
      "uniqueItems": true
    },
    "status": { "enum": ["live", "beta", "deprecated", "dead"] },
    "launched": { "type": ["integer", "null"], "minimum": 1980, "maximum": 2100 },
    "geo": {
      "description": "Factual 'who may trade' per the platform's own terms — never an evasion guide.",
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": { "enum": ["everyone", "permissionless", "global-restrictions", "allowlist", "unknown"] },
        "restricted": {
          "description": "ISO 3166-1 alpha-2, lowercase; for model: global-restrictions.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z]{2}$" },
          "uniqueItems": true
        },
        "allowed": {
          "description": "ISO 3166-1 alpha-2, lowercase; for model: allowlist.",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z]{2}$" },
          "uniqueItems": true
        },
        "source": { "type": ["string", "null"], "pattern": "^https?://" },
        "as_of": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "metrics": {
      "description": "Auto-filled by scripts/refresh.py — seed as nulls.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "volume_usd": { "type": ["number", "null"], "minimum": 0 },
        "period": { "enum": ["24h", "30d", null] },
        "source": { "type": ["string", "null"] },
        "as_of": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "data": {
      "description": "What data you can get out of this platform; cross-links data/sources/ slugs.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public_api": { "type": ["boolean", "null"] },
        "live_orderbook": { "type": ["boolean", "null"] },
        "historical": { "enum": ["none", "partial", "full", null] },
        "granularity": { "type": ["string", "null"], "maxLength": 100 },
        "free_archive": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "known_gaps": { "type": ["string", "null"], "maxLength": 420 },
        "recorder_support": { "enum": ["yes", "planned", "no", null] }
      }
    },
    "description": { "type": "string", "minLength": 10, "maxLength": 200 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true
    }
  }
}
